# Copy to .env and adjust if needed. Never commit secrets.
GARMENT_LEADS_GROUP_ID=284751225383775
GARMENT_LEADS_GROUP_URL=https://mbasic.facebook.com/groups/284751225383775/
GARMENT_LEADS_DB_PATH=./garment_leads.sqlite3
GARMENT_LEADS_EXPORT_DIR=./exports
GARMENT_LEADS_LOG_DIR=./logs
GARMENT_LEADS_RAW_RESPONSE_DIR=./raw_responses
GARMENT_LEADS_REQUEST_TIMEOUT=15
GARMENT_LEADS_RATE_LIMIT=1.0
# Dashboard binds to localhost by default. Override only if you understand the exposure risk.
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
# v3: FB session cookies (used for authenticated scraping against m.facebook.com)
GARMENT_LEADS_FB_COOKIES_PATH=           # default: $XDG_CONFIG_HOME/garment-leads/fb_cookies.json
GARMENT_LEADS_FB_COOKIE_MAX_AGE_DAYS=30
GARMENT_LEADS_FB_MIN_DELAY=2.0
GARMENT_LEADS_FB_MAX_DELAY=8.0
GARMENT_LEADS_FB_MAX_RPM=8
GARMENT_LEADS_FB_MAX_RETRIES=3
